# ==============================================================================
# VoiceShield Console Backend - Environment Configuration Template
# Target Database: AWS RDS PostgreSQL (voiceshield_console)
# Target Region: ap-south-2
# IMPORTANT: Never commit actual production passwords or secret keys.
# ==============================================================================

# Application Server
PORT=4000
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (AWS RDS)
# ------------------------------------------------------------------------------
# Discrete parameters (Recommended for Render, AWS ECS, and production):
DATABASE_HOST=voiceshield-prod-db.chcku4ke2u3b.ap-south-2.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=voiceshield_console
DATABASE_USER=voiceshield_console_user
DATABASE_PASSWORD=your_production_password_here

# SSL / TLS Settings for AWS RDS
DATABASE_SSL=true
# Optional: path to RDS CA bundle (e.g., /etc/ssl/certs/global-bundle.pem)
# DATABASE_SSL_CA=
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Alternative single connection URL (supported as fallback):
# DATABASE_URL=postgresql://voiceshield_console_user:your_password@voiceshield-prod-db.chcku4ke2u3b.ap-south-2.rds.amazonaws.com:5432/voiceshield_console?sslmode=require

# Connection Pool Settings (Optimized for Render Free Tier & RDS Limits)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT=5000
DATABASE_IDLE_TIMEOUT=30000

# AWS RDS Metadata
RDS_IDENTIFIER=voiceshield-prod-db
AWS_REGION=ap-south-2

# ------------------------------------------------------------------------------
# Authentication & Security (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-replace-in-production-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Storage / Evidence & Exports
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
AWS_S3_BUCKET=voiceshield-evidence-production
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key
