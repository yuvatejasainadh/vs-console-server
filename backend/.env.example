# VoiceShield Console Backend Environment Configuration
PORT=4000
APP_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://voiceshield_user:voiceshield_password@localhost:5432/voiceshield_console?sslmode=disable
RDS_IDENTIFIER=voiceshield-production-rds

# Authentication & Security
JWT_SECRET=super-secret-jwt-key-replace-in-production-minimum-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=super-secret-refresh-key-replace-in-production-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# AWS S3 / Object Storage Configuration (for evidence files & exports)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
AWS_REGION=us-east-1
AWS_S3_BUCKET=voiceshield-evidence-production
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key
